[Unit]
Description=DXT FUSE Agent
After=network-online.target
Requires=network-online.target

[Service]
WorkingDirectory=/opt/dxt/agent-fuse
EnvironmentFile=/opt/dxt/agent-fuse/.env
ExecStart=/usr/bin/python3 main.py
Restart=always
User=dxtsvc
Group=dxtsvc
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
CapabilityBoundingSet=CAP_SYS_ADMIN
# FUSE는 root 권한이 필요하여 CAP_SYS_ADMIN 허용

[Install]
WantedBy=multi-user.target
