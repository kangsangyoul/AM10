#!/usr/bin/env python3
import os, subprocess, click, requests, json, time

MANAGER = os.getenv('MANAGER_URL', 'http://127.0.0.1:8080')
ENV_MANAGER = '/opt/dxt/manager-api/.env'
ENV_AGENT = '/opt/dxt/agent-fuse/.env'


def get_jwt():
    if os.path.exists(ENV_MANAGER):
        for line in open(ENV_MANAGER):
            if line.startswith('MANAGER_JWT') or line.startswith('MANAGER_JWT_KEYS'):
                val = line.split('=')[1].strip().strip('"')
                return val.split(',')[0]
    return ''

HEADERS = lambda: {'Authorization': get_jwt()}

@click.group()
def cli():
    """DXTENC helper CLI"""
    pass

@cli.command()
def status():
    """Show service and mount status"""
    subs = ['dxtenc-manager.service','dxtenc-agent.service']
    for s in subs:
        try:
            out = subprocess.check_output(['systemctl','is-active',s], stderr=subprocess.STDOUT).decode().strip()
        except subprocess.CalledProcessError:
            out = 'inactive'
        click.echo(f"{s}: {out}")
    click.echo(f"/secure_mnt exists: {os.path.ismount('/secure_mnt') or os.path.exists('/secure_mnt')}")

@cli.group()
def policy():
    pass

@policy.command('ls')
@click.option('--id', default='pol-main')
def policy_ls(id):
    r = requests.get(f"{MANAGER}/policies/{id}", headers=HEADERS(), timeout=5)
    click.echo(json.dumps(r.json(), indent=2))

@policy.command('set')
@click.option('--id', default='pol-main')
@click.option('--enabled', type=bool, default=True)
@click.option('--key-version', type=int, default=1)
def policy_set(id, enabled, key_version):
    payload = {'id': id, 'path': '/secure_src', 'enabled': enabled, 'key_version': key_version}
    r = requests.post(f"{MANAGER}/policies", headers=HEADERS(), json=payload, timeout=5)
    click.echo(r.status_code)

@cli.group()
def key():
    pass

@key.command('rotate')
@click.option('--policy-id', default='pol-main')
def key_rotate(policy_id):
    import secrets
    new_ver = int(time.time())
    k = secrets.token_hex(32)
    payload = {'policy_id': policy_id, 'version': new_ver, 'key_hex': k, 'state': 'ACTIVE'}
    r = requests.post(f"{MANAGER}/keys", headers=HEADERS(), json=payload, timeout=5)
    click.echo(r.status_code)

@cli.group()
def log():
    pass

@log.command('tail')
@click.option('--lines', default=20)
def log_tail(lines):
    subprocess.call(['journalctl','-u','dxtenc-manager','-u','dxtenc-agent','-n',str(lines)])

if __name__ == '__main__':
    cli()
